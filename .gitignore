bin
# Directories only, so the pattern cannot swallow Bazel's BUILD files: on a
# case-insensitive filesystem "!BUILD" un-ignored "build/" along with them.
*build*/
.DS_Store
.cache/
.idea/
.vscode/
.tmp/
__pycache__/
aqtinstall.log
*.user
/*.prof
bazel-*

# CMake/QtCreator folders and files created on Windows
CMakeFiles/
*/CMakeFiles/
CMakeCache*.*
Makefile*
moc_*.*
mocs_*.*
qrc_*.*
cmake_install.cmake
*/cmake_install.cmake
